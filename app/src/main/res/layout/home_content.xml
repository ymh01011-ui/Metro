<?xml version="1.0" encoding="utf-8"?><!--
  ~ Home content. Every block starts and ends on the same vertical lines as the search bar
  ~ (@dimen/home_content_margin from each side).
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- 3 x 2 square tiles: outer tile edges sit on the search-bar lines -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tilesGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/home_tiles_padding"
        android:paddingTop="@dimen/home_tiles_top_padding"
        android:paddingEnd="@dimen/home_tiles_padding">

        <include
            android:id="@+id/tileHistory"
            layout="@layout/item_home_tile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tileMostPlayed"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/tileMostPlayed"
            layout="@layout/item_home_tile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/tileHistory"
            app:layout_constraintEnd_toStartOf="@id/tileFavorite"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/tileFavorite"
            layout="@layout/item_home_tile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/tileMostPlayed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/tileForYouNow"
            layout="@layout/item_home_tile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tileRediscover"
            app:layout_constraintTop_toBottomOf="@id/tileHistory" />

        <include
            android:id="@+id/tileRediscover"
            layout="@layout/item_home_tile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/tileForYouNow"
            app:layout_constraintEnd_toStartOf="@id/tileStats"
            app:layout_constraintTop_toBottomOf="@id/tileMostPlayed" />

        <include
            android:id="@+id/tileStats"
            layout="@layout/item_home_tile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/tileRediscover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tileFavorite" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Recently added: columns of 3 songs, scrolls sideways -->
    <LinearLayout
        android:id="@+id/recentSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/home_gap_after_tiles"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/recentHeader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/home_content_margin"
            android:paddingEnd="@dimen/home_chevron_end_padding">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_recently_added"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_chevron_right"
                app:tint="?android:attr/textColorSecondary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_recent_list_height"
            android:layout_marginTop="@dimen/home_recent_content_gap"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/home_content_margin"
            android:paddingEnd="0dp" />
    </LinearLayout>

    <!-- Pinned: albums (rounded squares) and artists (circles) -->
    <LinearLayout
        android:id="@+id/pinnedSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/home_gap_after_recent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/home_content_margin"
            android:paddingEnd="@dimen/home_content_margin"
            android:text="@string/home_pinned"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pinnedRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_header_content_gap"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/home_content_margin"
            android:paddingEnd="@dimen/home_content_margin" />
    </LinearLayout>

    <!-- Existing home sections (Favorites, top artists/albums ...) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/home_gap_after_pinned"
        android:orientation="vertical">

        <code.name.monkey.retromusic.views.insets.InsetsRecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="@integer/overScrollMode"
            android:paddingStart="@dimen/home_legacy_start_padding"
            android:paddingBottom="@dimen/mini_player_height"
            tools:itemCount="10"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_album_card"
            tools:spanCount="3" />
    </LinearLayout>
</LinearLayout>
