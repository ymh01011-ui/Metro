<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="32dp">

    <!-- أزرار التحكم -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!--
            backgroundTint هنا قيمة افتراضية بس (fallback) قبل ما الصورة تتحمل.
            بعد استخراج اللون، الكود في AbsArtistDetailsFragment.kt بيغيّرها
            لنفس لون خلفية الصفحة بشفافية، مع الحفاظ على strokeColor الأبيض
            زي ما هو عشان يدي تأثير زجاجي (glass).
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/infoAction"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="24dp"
            android:backgroundTint="#33FFFFFF"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@android:color/white"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="1dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/playAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="@android:color/white"
            app:tint="@android:color/black"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:fabCustomSize="64dp"
            app:iconSize="30dp"
            app:srcCompat="@drawable/ic_play_arrow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shuffleAction"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:backgroundTint="#33FFFFFF"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_shuffle"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@android:color/white"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- قائمة الأغاني -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Songs"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!--
            محل أيقونة الترتيب (اتنقلت لقايمة الثلاث نقاط باسم "Sort by").
            نص "See all" ثابت (hardcoded) هنا برضه — يفضل ينتقل لـ strings.xml.
            visibility=gone افتراضيًا، وبتتحكم فيه AbsArtistDetailsFragment.kt
            حسب عدد أغاني الفنان (بتظهر لو أكتر من 6).
        -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/seeAllSongs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:text="See all"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:nestedScrollingEnabled="false" />

    <!-- الألبومات -->
    <TextView
        android:id="@+id/albumTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Albums" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/albumRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="16dp" />

    <!-- الأغاني المنفردة -->
    <TextView
        android:id="@+id/singlesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Singles"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/singlesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="16dp" />

    <!-- الظهور مع فنانين آخرين -->
    <TextView
        android:id="@+id/appearsOnTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Appears On"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appearsOnRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="16dp" />

</LinearLayout>
