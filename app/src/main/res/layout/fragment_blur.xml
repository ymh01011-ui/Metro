<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <!-- Liquid background (rotating blurred cover). Must stay first, behind everything. -->
    <code.name.monkey.retromusic.views.LiquidBackgroundView
        android:id="@+id/liquidBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Old blur background, kept hidden so existing references still compile. -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/colorBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@color/black_color" />

    <View
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shadow_blur_theme"
        android:alpha="0.35"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <FrameLayout
        android:id="@+id/statusBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/status_bar" />
    </FrameLayout>


    <!-- Cover starts at ~12% of the screen height. The cover page itself already has a 16dp
         inner margin, so an 8dp margin here gives the 24dp side gap of the design. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/coverTopGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.121" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/playerAlbumCoverFragment"
        android:name="code.name.monkey.retromusic.fragments.player.PlayerAlbumCoverFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/coverTopGuideline" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/playbackControlsFragment"
        android:name="code.name.monkey.retromusic.fragments.player.blur.BlurPlaybackControlsFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/playerToolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerAlbumCoverFragment"
        tools:layout="@layout/fragment_blur_player_playback_controls" />

    <!-- Favorite + "more" circles at the right of the title (Apple Music style). The circle
         centers sit 65.5dp below the top of the controls area, between title and artist. -->
    <ImageButton
        android:id="@+id/favoriteCircleButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="51.5dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_blur_circle_button"
        android:contentDescription="@string/favorites"
        android:padding="4dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@+id/moreCircleButton"
        app:layout_constraintTop_toTopOf="@+id/playbackControlsFragment"
        app:srcCompat="@drawable/ic_favorite_border"
        app:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/moreCircleButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="51.5dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_blur_circle_button"
        android:contentDescription="More"
        android:padding="4dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/playbackControlsFragment"
        app:srcCompat="@drawable/ic_more_vert_blur"
        app:tint="@android:color/white" />

    <!-- Bottom icon row (lyrics, equalizer, queue), centered, 103dp between icon centers -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/playerToolbar"
        style="@style/Toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:background="@android:color/transparent"
        app:contentInsetEnd="0dp"
        app:contentInsetLeft="0dp"
        app:contentInsetRight="0dp"
        app:contentInsetStart="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playbackControlsFragment" />

</androidx.constraintlayout.widget.ConstraintLayout>
