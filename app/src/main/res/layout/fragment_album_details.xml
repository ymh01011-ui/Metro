<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:transitionGroup="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================================== -->
            <!-- حاوية الفيديو الجديدة (تأخذ شكل صورة Apple Music) -->
            <!-- ============================================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/videoHeaderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- إطار الفيديو / الصورة -->
                <FrameLayout
                    android:id="@+id/videoFrame"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1.15"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- الصورة الثابتة التي تظهر كفريم أول لسرعة التحميل -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/videoImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:srcCompat="@tools:sample/backgrounds/scenic" />

                    <!-- مشغل الفيديو (سيتم إظهاره بسلاسة عندما يكون جاهزاً) -->
                    <!-- يرجى التأكد من تحديث الحزمة حسب استخدامك (androidx.media3.ui.PlayerView أو com.google.android.exoplayer2.ui.PlayerView) -->
                    <androidx.media3.ui.PlayerView
                        android:id="@+id/videoPlayerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0" 
                        app:use_controller="false"
                        app:surface_type="texture_view"
                        app:resize_mode="zoom" />

                    <!-- تدرج لوني مبرمج يدمج الصورة/الفيديو مع الخلفية -->
                    <View
                        android:id="@+id/videoGradient"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <!-- أزرار التشغيل الخاصة بالفيديو -->
                <LinearLayout
                    android:id="@+id/videoButtonsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingBottom="24dp"
                    android:paddingTop="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/videoFrame">

                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
                        <code.name.monkey.retromusic.views.LiquidGlassView
                            android:id="@+id/videoShuffleActionGlass"
                            android:layout_width="match_parent" android:layout_height="match_parent" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/videoShuffleAction"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:backgroundTint="@android:color/transparent"
                            app:cornerRadius="22dp" app:icon="@drawable/ic_shuffle"
                            app:iconGravity="textStart" app:iconPadding="0dp"
                            app:iconSize="18dp" app:iconTint="@android:color/white" app:strokeWidth="0dp" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/videoPlayAction"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content" android:layout_height="44dp"
                        android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
                        android:minWidth="120dp" android:minHeight="0dp"
                        android:paddingStart="24dp" android:paddingEnd="26dp"
                        android:backgroundTint="@android:color/white"
                        android:insetTop="0dp" android:insetBottom="0dp"
                        android:text="@string/action_play" android:textColor="@android:color/black"
                        android:textStyle="bold" app:cornerRadius="22dp"
                        app:icon="@drawable/ic_play_arrow" app:iconGravity="textStart"
                        app:iconPadding="6dp" app:iconSize="18dp" app:iconTint="@android:color/black"
                        app:rippleColor="#33000000" app:strokeWidth="0dp" />

                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
                        <code.name.monkey.retromusic.views.LiquidGlassView
                            android:id="@+id/videoAddActionGlass"
                            android:layout_width="match_parent" android:layout_height="match_parent" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/videoAddAction"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:backgroundTint="@android:color/transparent"
                            app:cornerRadius="22dp" app:icon="@drawable/ic_album_add"
                            app:iconGravity="textStart" app:iconPadding="0dp"
                            app:iconSize="18dp" app:iconTint="@android:color/white" app:strokeWidth="0dp" />
                    </FrameLayout>
                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/videoAlbumMetaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="@style/TextViewCaption"
                    android:textColor="#B3FFFFFF"
                    app:layout_constraintBottom_toTopOf="@id/videoButtonsContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Pop • 12 Songs • 43 min" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/videoAlbumText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textAppearance="@style/TextViewSubtitle1"
                    android:textColor="#E6FFFFFF"
                    app:layout_constraintBottom_toTopOf="@id/videoAlbumMetaText"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Sabrina Carpenter" />

                <code.name.monkey.retromusic.views.BaselineGridTextView
                    android:id="@+id/videoAlbumTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextViewHeadline5"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/videoAlbumText"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Man's Best Friend" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ============================================== -->
            <!-- الحاوية الأصلية القديمة (للكروت المربعة) -->
            <!-- ============================================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <code.name.monkey.retromusic.views.SoftShadowView
                    android:id="@+id/imageShadow"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/imageCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="56dp"
                    android:layout_marginEnd="56dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="false"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="0dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:srcCompat="@tools:sample/backgrounds/scenic" />

                </com.google.android.material.card.MaterialCardView>

                <code.name.monkey.retromusic.views.BaselineGridTextView
                    android:id="@+id/albumTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextViewHeadline5"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imageCard"
                    tools:text="Man's Best Friend" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/albumText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textAppearance="@style/TextViewSubtitle1"
                    android:textColor="#E6FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/albumTitle"
                    tools:text="Sabrina Carpenter" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/albumMetaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="@style/TextViewCaption"
                    android:textColor="#B3FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/albumText"
                    tools:text="Pop • 12 Songs • 43 min" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <include
                android:id="@+id/fragment_album_content"
                layout="@layout/fragment_album_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <code.name.monkey.retromusic.views.TintableToolbar
            android:id="@+id/toolbar"
            style="@style/Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_arrow_back" />

    </com.google.android.material.appbar.AppBarLayout>

</FrameLayout>
