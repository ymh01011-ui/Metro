<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:transitionGroup="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- الهيدر بقى ConstraintLayout على خلفية مصمتة (لون الصفحة نفسه):
                 صورة الألبوم مربعة في النص بهامش على الجنبين، وتحتها العنوان/
                 الفنان/الميتاداتا زي تصميم Apple Music - مش overlay فوق الصورة
                 زي الأول. المسافة الفعلية فوق (paddingTop) بتتظبط من الكود
                 حسب ارتفاع التولبار + الـ status bar. الظل حوالين الصورة
                 مرسوم يدوي (bg_album_art_shadow) مش cardElevation، عشان
                 يطلع ناعم ومتناسق في كل الاتجاهات. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <!-- ظل ناعم مرسوم يدوي (bg_album_art_shadow) بدل الـ elevation
                     الأصلية - بيبان زيادة 8dp حوالين الكارت من كل الاتجاهات
                     وبيتخبى معظمه تحت الكارت نفسه. -->
                <View
                    android:id="@+id/imageShadow"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="48dp"
                    android:layout_marginTop="-8dp"
                    android:background="@drawable/bg_album_art_shadow"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/imageCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="56dp"
                    android:layout_marginEnd="56dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="false"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="0dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:srcCompat="@tools:sample/backgrounds/scenic" />

                </com.google.android.material.card.MaterialCardView>

                <code.name.monkey.retromusic.views.BaselineGridTextView
                    android:id="@+id/albumTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextViewHeadline5"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imageCard"
                    tools:text="Man's Best Friend" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/albumText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textAppearance="@style/TextViewSubtitle1"
                    android:textColor="#E6FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/albumTitle"
                    tools:text="Sabrina Carpenter" />

                <!-- سطر الميتاداتا زي Apple Music بالظبط: عدد الأغاني •
                     إجمالي المدة. -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/albumMetaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="@style/TextViewCaption"
                    android:textColor="#B3FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/albumText"
                    tools:text="Pop • 12 Songs • 43 min" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <include
                android:id="@+id/fragment_album_content"
                layout="@layout/fragment_album_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- الـ toolbar جوه rootLayout مباشرة، عايم edge-to-edge فوق الشاشة
         كلها طول الوقت، بنفس الفلسفة القديمة. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <code.name.monkey.retromusic.views.TintableToolbar
            android:id="@+id/toolbar"
            style="@style/Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_arrow_back" />

    </com.google.android.material.appbar.AppBarLayout>

</FrameLayout>
