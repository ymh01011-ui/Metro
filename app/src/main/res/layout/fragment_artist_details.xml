<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- حاوية الصورة والمعلومات -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="380dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

                <!-- التدرج الديناميكي -->
                <View
                    android:id="@+id/headerGradient"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <code.name.monkey.retromusic.views.BaselineGridTextView
                        android:id="@+id/artistTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextViewHeadline4"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        tools:text="Adele" />

                    <code.name.monkey.retromusic.views.BaselineGridTextView
                        android:id="@+id/text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:textAppearance="@style/TextViewCaption"
                        android:textColor="#B3FFFFFF"
                        tools:text="3 Albums • 3 Songs • 13:45" />
                </LinearLayout>
            </FrameLayout>

            <!-- محتوى الأغاني والألبومات يأتي تحت الصورة مباشرة بدون أي تداخل -->
            <include
                android:id="@+id/fragment_artist_content"
                layout="@layout/fragment_artist_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- شريط علوي ثابت شفاف، ياخد padding الـ status bar الصح -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_arrow_back" />

    </com.google.android.material.appbar.AppBarLayout>

</FrameLayout>
